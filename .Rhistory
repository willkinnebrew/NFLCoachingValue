library(tidyverse)
library(nflfastR)
library(nflreadr)
regular_season_score <- read.csv("../../data/processed/regular_season_success.csv")
postseason_score <- read.csv("../../data/processed/postseason_success.csv")
close_game_score <- read.csv("../../data/processed/close_game_success.csv")
aggressiveness_score <- read.csv("../../data/processed/aggressiveness_score.csv")
two_minute_score <- read.csv("../../data/processed/two_minute_score.csv")
division_game_score <- read.csv("../../data/processed/division_game_success.csv")
player_dev_score <- read.csv("../../data/processed/player_dev_score.csv")
coaches <- read.csv("../../data/raw/coaches.csv")
team_seasons <- coaches %>%
rename(season = Year, offense = Offense, coach = Coach, defense = Defense) %>%
select(season, team, coach, offense, defense) %>%
filter(season > 2014 & season < 2026)
scores <- team_seasons %>%
left_join(player_dev_score %>% select(season, team, coach, player_dev_percentile, offense_dev_percentile, defense_dev_percentile)) %>%
left_join(regular_season_score %>% select(season, team, coach, win_percentile)) %>%
left_join(postseason_score %>% select(season, team, coach, playoff_percentile)) %>%
left_join(close_game_score %>% select(season, team, coach, close_win_percentile)) %>%
left_join(aggressiveness_score %>% select(season, team, coach, aggressiveness_percentile = wp_percentile)) %>%
left_join(two_minute_score %>% select(season, team, coach, two_minute_percentile = wp_percentile)) %>%
left_join(division_game_score %>% select(season, team, coach, division_win_percentile)) %>%
rowwise() %>%
mutate(score = sum(c_across(6:last_col()))) %>%
ungroup() %>%
distinct()
best_coaches <- scores %>%
filter(season > 2016, season < 2026) %>%
pivot_longer(
cols = c(coach, offense, defense),
names_to = "role",
values_to = "coach_name"
) %>%
separate_rows(coach_name, sep = ",") %>%
mutate(coach_name = str_trim(coach_name)) %>%
filter(!is.na(coach_name), coach_name != "") %>%
# Assign weight by role
mutate(score_weighted = case_when(
role == "coach" ~ score,
role %in% c("offense", "defense") ~ score * 0.5,
TRUE ~ score
)) %>%
group_by(coach_name) %>%
summarise(
seasons = n_distinct(season),
total_score = sum(score_weighted, na.rm = TRUE),
avg_score = total_score / seasons,
# NEW: team tracking
n_teams = n_distinct(team),
teams = paste(sort(unique(team)), collapse = ", "),
.groups = "drop"
) %>%
arrange(desc(avg_score)) %>%
mutate(rank = row_number()) %>%
select(rank, coach_name, seasons, n_teams, teams, total_score)
# best coaching seasons since 2017
best_seasons <- scores %>%
filter(season > 2016) %>%
group_by(season, team, coach, offense, defense) %>%
summarise(score = mean(score)) %>%
ungroup() %>%
arrange(desc(score)) %>%
mutate(rank = row_number()) %>%
select(rank, season, team, score, everything())
best_seasons
write.csv(best_coaches, "../../data/processed/total_coach_scores.csv")
write.csv(best_seasons, "../../data/processed/best_season_scores.csv")
write.csv(scores, "../../data/processed/season_scores.csv")
library(tidyverse)
library(nflfastR)
library(nflreadr)
library(gt)
library(purrr)
best_coaches <- read.csv("../../data/processed/total_coach_scores.csv")
best_seasons <- read.csv("../../data/processed/best_season_scores.csv")
scores <- read.csv("../../data/processed/season_scores.csv")
coaches <- read.csv("../../data/raw/coaches.csv")
teams <- nflreadr::load_teams() %>%
select(team = team_abbr, team_logo_espn, team_color) %>%
mutate(team = case_when(
team == "OAK" ~ "LV",
team == "SD" ~ "LAC",
team == "STL" ~ "LA",
team == "WAS" ~ "WSH",
.default = team
)) %>%
mutate(team = ifelse(team == "LA", "LAR", team))
coach_latest_team <- scores %>%
filter(season > 2016, season < 2026) %>%
pivot_longer(
cols = c(coach, offense, defense),
names_to = "role",
values_to = "coach_name"
) %>%
separate_rows(coach_name, sep = ",") %>%
mutate(coach_name = str_trim(coach_name)) %>%
filter(!is.na(coach_name), coach_name != "") %>%
group_by(coach_name) %>%
slice_max(season, with_ties = FALSE) %>%
ungroup() %>%
select(coach_name, team)
table_data <- best_coaches %>%
left_join(coach_latest_team, by = "coach_name") %>%
rename(latest_team = team) %>%
left_join(teams, by = c("latest_team" = "team"))
logos_df <- scores %>%
filter(season > 2016, season < 2026) %>%
pivot_longer(
cols = c(coach, offense, defense),
names_to = "role",
values_to = "coach_name"
) %>%
separate_rows(coach_name, sep = ",") %>%
mutate(coach_name = str_trim(coach_name)) %>%
filter(!is.na(coach_name), coach_name != "") %>%
distinct(coach_name, team) %>%
left_join(teams, by = c("team")) %>%
group_by(coach_name) %>%
summarise(
logos = paste0(team_logo_espn, collapse = " "),
.groups = "drop"
)
final_table <- table_data %>%
left_join(logos_df, by = "coach_name") %>%
arrange(desc(total_score)) %>%
select(rank, coach_name, seasons, total_score, logos, team_color)
# Keep only top 10
final_table_top10 <- final_table %>%
arrange(desc(total_score)) %>%
slice_head(n = 10)
# Build GT table
gt_tbl <- final_table_top10 %>%
gt() %>%
# Render logos
text_transform(
locations = cells_body(columns = logos),
fn = function(x) {
map(x, ~ {
urls <- strsplit(.x, " ")[[1]]
paste0(
web_image(url = urls, height = 25),
collapse = " "
)
})
}
) %>%
cols_label(
coach_name = "Coach",
seasons = "Seasons",
total_score = "Score",
logos = "Teams"
)
# Apply row-wise coloring
for (i in seq_len(nrow(final_table_top10))) {
gt_tbl <- gt_tbl %>%
tab_style(
style = cell_text(color = final_table_top10$team_color[i]),
locations = cells_body(
rows = i,
columns = c(coach_name, total_score)
)
)
}
# Final polish
gt_tbl <- gt_tbl %>%
cols_align(align = "center", logos) %>%
fmt_number(columns = total_score, decimals = 2) %>%
tab_style(
style = cell_text(weight = "bold"),
locations = cells_body(columns = coach_name)
) %>%
cols_hide(columns = c(team_color, rank))
gt_tbl
gtsave(gt_tbl, "../../output/tables/top10_coaches_since2017.png")
best_seasons_tbl <- scores %>%
filter(season > 2016) %>%
group_by(season, team, coach, offense, defense) %>%
summarise(score = mean(score), .groups = "drop") %>%
arrange(desc(score)) %>%
mutate(rank = row_number()) %>%
# Join team logos/colors
left_join(teams, by = c("team")) %>%
# Keep only what we want
select(
rank,
logos = team_logo_espn,
team,
season,
score,
coach,
offense,
defense,
team_color
) %>%
# Optional: top 10
slice_head(n = 10)
best_seasons_tbl <- best_seasons_tbl %>%
mutate(team_color = ifelse(is.na(team_color), "black", team_color))
# -------------------------------
# Build GT table
# -------------------------------
gt_tbl <- best_seasons_tbl %>%
gt() %>%
# Render logos
text_transform(
locations = cells_body(columns = logos),
fn = function(x) {
map(x, ~ web_image(url = .x, height = 30))
}
) %>%
cols_label(
logos = "",
team = "Team",
season = "Season",
score = "Score",
coach = "Head Coach",
offense = "OC",
defense = "DC"
)
# -------------------------------
# Row-wise coloring (team color)
# -------------------------------
for (i in seq_len(nrow(best_seasons_tbl))) {
gt_tbl <- gt_tbl %>%
tab_style(
style = cell_text(color = best_seasons_tbl$team_color[i]),
locations = cells_body(
rows = i,
columns = c(team, score, coach, offense, defense, score)
)
)
}
# -------------------------------
# Final polish
# -------------------------------
gt_tbl <- gt_tbl %>%
cols_align(align = "center", logos) %>%
fmt_number(columns = score, decimals = 2) %>%
cols_hide(columns = c(team_color)) %>%
tab_style(
style = cell_text(weight = "bold"),
locations = cells_body(columns = coach)
)
gt_tbl
gtsave(gt_tbl, "../../output/tables/top10_seasons_since2017.png")
