library(tidyverse)
library(nflfastR)
library(nflreadr)
folder <- "../../data/processed/"
files <- list.files(folder, pattern = "^player_apm_.*\\.csv$", full.names = TRUE)
years <- c()
# loop through files and create a data frame for each one
player_apm_all <- data.frame()
for (file in files) {
df_name <- tools::file_path_sans_ext(basename(file))
player_apm_all <- player_apm_all %>%
bind_rows(assign(df_name, read.csv(file)))
year <- as.numeric(sub("player_apm_", "", df_name))
years <- c(years, year)
}
players_pfr <- load_players(file_type = getOption("nflreadr.prefer", default = "rds")) %>%
select(pfr_id, nfl_id = gsis_id, draft_year, draft_pick, rookie_season)
snaps <- nflreadr::load_snap_counts(years) %>%
mutate(n_snaps = offense_snaps + defense_snaps + st_snaps) %>%
group_by(pfr_player_id, season) %>%
summarise(n_snaps = sum(n_snaps)) %>%
left_join(players_pfr, by = c("pfr_player_id" = "pfr_id"))
players <- player_apm_all %>%
select(nfl_id, full_name) %>%
distinct() %>%
arrange(full_name)
player_apm <- player_apm_all %>%
left_join(snaps, by = c("nfl_id", "season")) %>%
mutate(experience = season - rookie_season)
player_model_data <- player_apm %>%
arrange(nfl_id, season) %>%
group_by(nfl_id) %>%
mutate(
apm_lag1 = lag(apm),
exp_lag1 = lag(experience),
snaps_lag1 = lag(n_snaps)
) %>%
ungroup() %>%
filter(!is.na(apm_lag1), !is.na(exp_lag1), !is.na(draft_pick))
apm_model <- lm(
apm ~ apm_lag1 +
exp_lag1 +
I(exp_lag1^2) +
draft_pick +
log(snaps_lag1 + 1) +
n_snaps +
experience +
position,
data = player_model_data
)
player_model_data <- player_model_data %>%
mutate(predicted_apm = predict(apm_model)) %>%
mutate(residual_apm = apm - predicted_apm)
coaches <- read.csv("../../data/raw/coaches.csv")
position_side_map <- tibble(
position = c("QB","RB","FB","WR","TE","OL","K","P","LS","DL","LB","DB"),
side     = c("Offense","Offense","Offense","Offense","Offense","Offense",
"Special","Special","Special","Defense","Defense","Defense")
)
apm_test <- player_model_data %>%
left_join(position_side_map, by = "position") %>%
mutate(side = ifelse(is.na(side), "Unknown", side)) %>%
left_join(
coaches %>% select(season = Year, team, coach = Coach, Offense, Defense),
by = c("team", "season")
) %>%
filter(!is.na(n_snaps), !is.na(coach)) %>%
# Exclude Special Teams positions
filter(side %in% c("Offense", "Defense")) %>%
group_by(coach, season, side) %>%
summarise(
team = unique(team),
apm_diff = weighted.mean(residual_apm, n_snaps, na.rm = TRUE),
n_players = n(),
.groups = "drop_last"
) %>%
pivot_wider(
names_from = side,
values_from = c(apm_diff, n_players),
names_glue = "{side}_{.value}"
) %>%
# total only counts Offense + Defense
mutate(total_apm_diff = Offense_apm_diff + Defense_apm_diff) %>%
arrange(desc(total_apm_diff))
player_dev_score <- apm_test %>%
group_by(season) %>%
mutate(player_dev_percentile = percent_rank(total_apm_diff)) %>%
mutate(offense_dev_percentile = percent_rank(Offense_apm_diff)) %>%
mutate(defense_dev_percentile = percent_rank(Defense_apm_diff)) %>%
select(season, team, total_apm_diff, player_dev_percentile, offense_dev_percentile, defense_dev_percentile, coach) %>%
left_join(coaches %>% select(team, season = Year, offense = Offense, defense = Defense))
write.csv(player_dev_score, "../../data/processed/player_dev_score.csv")
library(tidyverse)
library(nflfastR)
library(nflreadr)
regular_season_score <- read.csv("../../data/processed/regular_season_success.csv")
postseason_score <- read.csv("../../data/processed/postseason_success.csv")
close_game_score <- read.csv("../../data/processed/close_game_success.csv")
aggressiveness_score <- read.csv("../../data/processed/aggressiveness_score.csv")
two_minute_score <- read.csv("../../data/processed/two_minute_score.csv")
division_game_score <- read.csv("../../data/processed/division_game_success.csv")
player_dev_score <- read.csv("../../data/processed/player_dev_score.csv")
coaches <- read.csv("../../data/raw/coaches.csv")
team_seasons <- coaches %>%
rename(season = Year, offense = Offense, coach = Coach, defense = Defense) %>%
select(season, team, coach, offense, defense) %>%
filter(season > 2014 & season < 2026)
scores <- team_seasons %>%
left_join(player_dev_score %>% select(season, team, coach, player_dev_percentile, offense_dev_percentile, defense_dev_percentile)) %>%
left_join(regular_season_score %>% select(season, team, coach, win_percentile)) %>%
left_join(postseason_score %>% select(season, team, coach, playoff_percentile)) %>%
left_join(close_game_score %>% select(season, team, coach, close_win_percentile)) %>%
left_join(aggressiveness_score %>% select(season, team, coach, aggressiveness_percentile = wp_percentile)) %>%
left_join(two_minute_score %>% select(season, team, coach, two_minute_percentile = wp_percentile)) %>%
left_join(division_game_score %>% select(season, team, coach, division_win_percentile)) %>%
rowwise() %>%
mutate(score = sum(c_across(6:last_col()))) %>%
ungroup()
# best coaches since x year
best_coaches <- scores %>%
filter(season > 2015, season < 2022) %>%
pivot_longer(
cols = c(coach, offense, defense),
names_to = "role",
values_to = "coach_name"
) %>%
separate_rows(coach_name, sep = ",") %>%
mutate(coach_name = str_trim(coach_name)) %>%
filter(!is.na(coach_name), coach_name != "") %>%
# Assign weight by role
mutate(score_weighted = case_when(
role == "coach"   ~ score,      # head coach full score
role %in% c("offense", "defense") ~ score * 0.25,  # assistants get half
TRUE ~ score
)) %>%
group_by(coach_name) %>%
summarise(
seasons = n(),
total_score = sum(score_weighted, na.rm = TRUE),
avg_score = total_score / seasons,
.groups = "drop"
) %>%
arrange(desc(avg_score)) %>%
mutate(rank = row_number()) %>%
select(rank, coach_name, seasons, total_score)
best_coaches
# best coaching seasons since 2015
best_seasons <- scores %>%
filter(season > 2016) %>%
group_by(season, team, coach, offense, defense) %>%
summarise(score = mean(score)) %>%
ungroup() %>%
arrange(desc(score)) %>%
mutate(rank = row_number()) %>%
select(rank, season, team, score, everything())
best_seasons
write.csv(best_coaches, "../../data/processed/total_coach_scores.csv")
write.csv(best_seasons, "../../data/processed/best_season_scores.csv")
write.csv(scores, "../../data/processed/season_scores.csv")
View(scores)
