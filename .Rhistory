library(tidyverse)
library(nflfastR)
library(nflreadr)
records <- read.csv("../../data/processed/team_records.csv")
post_success <- records %>%
mutate(playoff_success = case_when(
won_sb ~ 6,
round_reached == "SB" ~ 5,
round_reached == "CON" ~ 4,
round_reached == "DIV" ~ 3,
round_reached == "WC" ~ 2,
.default = 1
)) %>%
group_by(season) %>%
mutate(playoff_percentile = percent_rank(playoff_success)) %>%
select(season, team, coach, offense, defense, playoff_wins, playoff_success, playoff_percentile)
write.csv(post_success, "../../data/processed/postseason_success.csv")
fired <- c("TEN", "NYG", "ATL", "CLE", "LV", "BUF", "ARI", "BAL", "MIA")
post_success %>%
filter(season == 2025, team %in% fired) %>%
select(season, team, one_score_wins, one_score_losses) %>%
summarise(wins = sum(one_score_wins), losses = sum(one_score_losses), pct = wins/(wins+losses))
View(post_success)
