library(cmdstanr)
cmdstan_path()
install_cmdstan()
stan_code <- "
data {
int<lower=1> N;               // number of plays
int<lower=1> P;               // number of players
matrix[N, P] X;               // design matrix
vector[N] y;                  // EPA
}
parameters {
real alpha;                   // baseline EPA
vector[P] beta;               // player APM
real<lower=0> sigma;          // noise
real<lower=0> tau;            // shrinkage
}
model {
// Priors
alpha ~ normal(0, 0.5);
tau   ~ normal(0, 0.5);
beta  ~ normal(0, tau);
sigma ~ normal(0, 1);
// Likelihood
y ~ normal(alpha + X * beta, sigma);
}
"
library(cmdstanr)
stan_data <- list(
N = nrow(X),
P = ncol(X),
X = as.matrix(X),
y = y
)
model <- cmdstan_model(stan_code)
library(rstan)
options(mc.cores = parallel::detectCores())
rstan_options(auto_write = TRUE)
stan_model <- stan_model(model_code = stan_code)
stan_data <- list(
N = nrow(X),
P = ncol(X),
X = as.matrix(X),
y = y
)
fit <- sampling(
stan_model,
data = stan_data,
chains = 4,
iter = 1000,
warmup = 500,
control = list(adapt_delta = 0.9)
)
fit <- sampling(
stan_model,
data = stan_data,
chains = 4,
iter = 1000,
warmup = 500,
refresh = 10,        # <-- prints every 10 iterations
verbose = TRUE,      # <-- extra diagnostics
control = list(adapt_delta = 0.9)
)
fit <- sampling(
stan_model,
data = stan_data,
chains = 4,
iter = 1000,
warmup = 500,
refresh = 1,        # <-- prints every 10 iterations
verbose = TRUE,      # <-- extra diagnostics
