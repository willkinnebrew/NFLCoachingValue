# best coaches since x year
scores %>%
filter(season > 2024) %>%
pivot_longer(
cols = c(coach, offense, defense),
names_to = "role",
values_to = "coach_name"
) %>%
group_by(coach_name) %>%
summarise(
seasons = n(),
score = mean(score),
.groups = "drop"
) %>%
arrange(desc(score)) %>%
mutate(rank = row_number()) %>%
select(rank, coach_name, seasons, score)
